@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix iof-core: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix iof-constr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix bfo: <http://purl.obolibrary.org/obo/bfo.owl> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


# ===== ONTOLOGY METADATA =====
<http://unimaas-project.eu/MSCOntology> a owl:Ontology ;
    owl:versionIRI <http://unimaas-project.eu/MSCOntology/1.2.0> ;
    owl:versionInfo "1.2.0" ;
    dcterms:title "Manufacturing Service Chain Ontology" ;
    dcterms:created "2026-02-24"^^xsd:date ;
    dcterms:modified "2026-05-27"^^xsd:date ;
    dcterms:issued "2026-05-27"^^xsd:date ;
    dcterms:creator "NTUA" ;
    dcterms:contributor "FLM" ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "manufacturing service chain", "ontology" ;
    rdfs:seeAlso <https://spec.industrialontologies.org/ontology/core/Core/> ;
    rdfs:comment "This ontology is aligned with IOF Core through lightweight mapping annotations. It does not fully import IOF Core in order to preserve application-level simplicity." .


# ===== CLASS DEFINITIONS =====
sc:ConfigurableEntity a owl:Class ;
    rdfs:label "Configurable Entity" ;
    rdfs:comment "Base class for entities that have characteristics" .

sc:Product a owl:Class ;
    rdfs:label "Product" ;
    skos:closeMatch iof-constr:MaterialProduct ;
    rdfs:comment "MSC Product is aligned with IOF Material Product. In MSC, a product may be an input to or output of manufacturing service-chain steps." .

sc:CustomerRequirement a owl:Class ;
    rdfs:label "Customer Requirement" ;
    rdfs:subClassOf iof-constr:RequirementSpecification ;    
    skos:closeMatch iof-constr:RequirementSpecification ;
    rdfs:comment "Specifications required by customer" .

sc:ProcessConfiguration a owl:Class ;
    rdfs:label "Process Configuration" ;
    rdfs:subClassOf iof-constr:PlanSpecification ;    
    skos:closeMatch iof-constr:PlanSpecification ;
    rdfs:comment "MSC Process Configuration is aligned with IOF Plan Specification because it specifies a configured manufacturing service-chain step, binding the specific input and output parameters" .

sc:Process a owl:Class ;
    rdfs:label "Process" ;
    skos:closeMatch iof-constr:ManufacturingProcess ;    
    skos:relatedMatch iof-constr:AssemblyProcess ;    
    skos:relatedMatch iof-constr:ComputingProcess ;    
    rdfs:comment "MSC Process is aligned with IOF Manufacturing Process for physical manufacturing and assembly operations, and related to IOF Computing Process for virtual or digital processes." .

sc:Resource a owl:Class ;
    rdfs:label "Resource" ;
    skos:closeMatch iof-constr:MaterialResource ;    
    skos:relatedMatch iof-constr:MaterialResourceRole ;    
    rdfs:comment "MSC Resource is aligned with IOF Material Resource at a lightweight mapping level. MSC Resource is broader because it may include material resources, workforce, software, and other assets required to perform processes." .

sc:MaterialResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:MaterialResource ;
    rdfs:label "Material Resource" ;
    rdfs:comment "Physical/material resource used in a manufacturing service chain." .

sc:HumanResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:Person ;
    skos:relatedMatch iof-constr:Agent ;
    rdfs:label "Human Resource" ;
    rdfs:comment "Human workforce resource used in a manufacturing service chain." .

sc:SoftwareResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:InformationContentEntity ;
    skos:relatedMatch iof-constr:Algorithm ;
    skos:relatedMatch iof-constr:EncodedAlgorithm ;
    rdfs:label "Software Resource" ;
    rdfs:comment "Software, algorithmic, or informational resource used in a manufacturing service chain." .

sc:EquipmentResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:PieceOfEquipment ;
    skos:relatedMatch iof-constr:EngineeredSystem ;
    skos:relatedMatch iof-constr:MaterialArtifact ;
    rdfs:label "Equipment Resource" ;
    rdfs:comment "Equipment or machinery resource used in a manufacturing service chain." .

sc:ResourceConf a owl:Class ;
    rdfs:label "Resource Configuration" ;  
    rdfs:comment "MSC Resource Configuration is inserted between ProcessConfigurations and Resource nodes to allow multiple uses of the same resource in different configurations." .

sc:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "Supplier of resources" .

sc:Site a owl:Class ;
    rdfs:label "Manufacturing Site" ;
    rdfs:subClassOf bfo:BFO_0000029 ;    
    skos:closeMatch bfo:BFO_0000029 ;    
    rdfs:comment "Physical location where processes are performed. MSC Site is aligned with BFO Site, used in IOF as physical location." .

sc:Device a owl:Class ;
    rdfs:label "Device" ;
    skos:closeMatch iof-constr:PieceOfEquipment ;    
    skos:relatedMatch iof-constr:EngineeredSystem ;    
    skos:relatedMatch iof-constr:MaterialArtifact ;    
    rdfs:comment "Equipment or machinery at a site. MSC Device is aligned with IOF Piece of Equipment and related to Engineered System and Material Artifact." .

sc:Characteristic a owl:Class ;
    rdfs:label "Characteristic" ;
    skos:relatedMatch iof-constr:Capability ;    
    skos:relatedMatch iof-constr:ProcessCharacteristic ;    
    skos:relatedMatch bfo:BFO_0000019 ;    
    skos:relatedMatch bfo:BFO_0000020 ;    
    rdfs:comment "MSC Characteristic is a lightweight abstraction for attributes of products, resources, devices, sites, or suppliers. It may correspond to an IOF Capability, IOF Process Characteristic, BFO Quality, or other specifically dependent continuant depending on context." .

sc:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    skos:closeMatch iof-constr:PieceOfEquipment ;    
    skos:relatedMatch iof-constr:MeasurementCapability ;    
    skos:relatedMatch iof-constr:MeasurementProcess ;    
    rdfs:comment "Measurement device. MSC Sensor is aligned with IOF equipment and measurement capability patterns. A sensor is treated as equipment capable of participating in measurement processes." .

sc:LogisticRoute a owl:Class ;
    rdfs:label "Logistic Route" ;
    skos:relatedMatch iof-constr:MaterialLocationChangeProcess ;    
    skos:relatedMatch iof-constr:PlanSpecification ;    
    rdfs:comment "Transportation route between locations. MSC Logistic Route is aligned with IOF Material Location Change Process when interpreted as transportation activity, and with IOF Plan Specification when interpreted as a route specification." .
    
sc:Location a owl:Class ;
    rdfs:label "Location" ;
    skos:closeMatch bfo:BFO_0000029 ;    
    skos:relatedMatch iof-constr:PhysicalLocationIdentifier ;    
    rdfs:comment "MSC Location is aligned with BFO Site/physical location. When modelled as an identifier such as an address or GPS coordinate, it is related to IOF Physical Location Identifier." .

sc:Device rdfs:subClassOf sc:ConfigurableEntity .
sc:Site rdfs:subClassOf sc:ConfigurableEntity .
sc:Supplier rdfs:subClassOf sc:ConfigurableEntity .
sc:Resource rdfs:subClassOf sc:ConfigurableEntity .
sc:Process rdfs:subClassOf sc:ConfigurableEntity .
sc:Product rdfs:subClassOf sc:ConfigurableEntity .

# ===== OBJECT PROPERTIES =====

sc:satisfiesRequirement a owl:ObjectProperty ;
    rdfs:label "satisfies requirement" ;
    rdfs:domain sc:Product ;
    rdfs:range sc:CustomerRequirement .

sc:hasComponent a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has component" ;
    rdfs:domain sc:Product ;
    rdfs:range sc:Product .

sc:requiresProcess a owl:ObjectProperty ;
    rdfs:label "requires process" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Process .

sc:usesResource a owl:ObjectProperty ;
    rdfs:label "uses resource" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Resource .

sc:usesResourceConf a owl:ObjectProperty ;
    rdfs:label "uses resource configuration" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:ResourceConf .

sc:refersToResource a owl:ObjectProperty ;
    rdfs:label "refers to resource" ;
    rdfs:domain sc:ResourceConf ;
    rdfs:range sc:Resource .

sc:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Product .

sc:hasInput a owl:ObjectProperty ;
    rdfs:label "has input" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Product .

sc:hasPreviousStep a owl:ObjectProperty ;
    rdfs:label "has previous step" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:ProcessConfiguration ;
    owl:inverseOf sc:hasNextStep .

sc:hasNextStep a owl:ObjectProperty ;
    rdfs:label "has next step" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:ProcessConfiguration ;
    owl:inverseOf sc:hasPreviousStep .

sc:isProvidedBy a owl:ObjectProperty ;
    rdfs:label "is provided by" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (sc:Resource sc:Product)
    ] ;
    rdfs:range sc:Supplier ;
    owl:inverseOf sc:provides .

sc:provides a owl:ObjectProperty ;
    rdfs:label "provides" ;
    rdfs:domain sc:Supplier ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (sc:Resource sc:Product)
    ] ;
    owl:inverseOf sc:isProvidedBy .

sc:isPerformedAt a owl:ObjectProperty ;
    rdfs:label "is performed at" ;
    rdfs:domain sc:Process ;
    rdfs:range sc:Site ;
    owl:inverseOf sc:performs .

sc:performs a owl:ObjectProperty ;
    rdfs:label "performs" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Process ;
    owl:inverseOf sc:isPerformedAt .

sc:hasDevice a owl:ObjectProperty ;
    rdfs:label "has device" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Device .

sc:hasCharacteristic a owl:ObjectProperty ;
    rdfs:label "has characteristic" ;
    rdfs:domain sc:ConfigurableEntity ;
    rdfs:range sc:Characteristic .

sc:observes a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:domain sc:Sensor ;
    rdfs:range sc:Characteristic ;
    owl:inverseOf sc:isObservedBy .

sc:isObservedBy a owl:ObjectProperty ;
    rdfs:label "is observed by" ;
    rdfs:domain sc:Characteristic ;
    rdfs:range sc:Sensor ;
    owl:inverseOf sc:observes .

sc:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (sc:Site sc:Supplier)
    ] ;
    rdfs:range sc:Location .

sc:hasStartingPoint a owl:ObjectProperty ;
    rdfs:label "has starting point" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range sc:Location ;
    rdfs:comment "The origin location of the route" .
 
sc:hasEndingPoint a owl:ObjectProperty ;
    rdfs:label "has ending point" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range sc:Location ;
    rdfs:comment "The destination location of the route" .

# ===== DATA PROPERTIES =====

sc:id a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

sc:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

sc:resourceType a owl:DatatypeProperty ;
    rdfs:label "resource type" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:string .

sc:processingRate a owl:DatatypeProperty ;
    rdfs:label "processing rate" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:decimal .

sc:greenOperationLevel a owl:DatatypeProperty ;
    rdfs:label "green operation level" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:decimal .

sc:transmissionUnit a owl:DatatypeProperty ;
    rdfs:label "transmission unit" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:string .

sc:transportationMode a owl:DatatypeProperty ;
    rdfs:label "transportation mode" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:string .

sc:transmissionCost a owl:DatatypeProperty ;
    rdfs:label "transmission cost" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:decimal .

sc:sensorValue a owl:DatatypeProperty ;
    rdfs:label "sensor value" ;
    rdfs:domain sc:Sensor ;
    rdfs:range xsd:decimal .

