@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix iof-core: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix iof-constr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


# ===== ONTOLOGY METADATA =====
<http://unimaas-project.eu/MSCOntology> a owl:Ontology ;
    owl:versionIRI <http://unimaas-project.eu/MSCOntology/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    dcterms:title "Manufacturing Service Chain Ontology" ;
    dcterms:created "2026-02-24"^^xsd:date ;
    dcterms:modified "2026-12-07"^^xsd:date ;
    dcterms:issued "2026-12-07"^^xsd:date ;
    dcterms:creator "NTUA" ;
    dcterms:contributor "FLM" ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "manufacturing service chain", "ontology" ;
    rdfs:seeAlso <https://spec.industrialontologies.org/ontology/core/Core/> ;
    rdfs:comment "This ontology is aligned with IOF Core through lightweight mapping annotations. It does not fully import IOF Core in order to preserve application-level simplicity." .


# ===== CLASS DEFINITIONS =====
sc:ConfigurableEntity a owl:Class ;
    rdfs:label "Configurable Entity" ;
    rdfs:comment "Base class for entities that have characteristics" .

sc:Product a owl:Class ;
    rdfs:label "Product" ;
    skos:narrowMatch iof-constr:MaterialProduct ;
    skos:narrowMatch iof-constr:MaterialArtifact;
    skos:narrowMatch iof-constr:Assembly;
    rdfs:comment "In MSC, a product may be an input to or output of manufacturing service-chain steps." .

sc:CustomerRequirement a owl:Class ;
    rdfs:label "Customer Requirement" ;
    rdfs:subClassOf iof-constr:RequirementSpecification ;    
    skos:broadMatch iof-constr:RequirementSpecification ;
    rdfs:comment "Specifications required by customer" .

sc:ProcessConfiguration a owl:Class ;
    rdfs:label "Process Configuration" ;
    rdfs:subClassOf iof-constr:PlanSpecification ;    
    skos:broadMatch iof-constr:PlanSpecification ;
    rdfs:comment "MSC Process Configuration specifies a configured manufacturing service-chain step, binding the specific input and output parameters" .

sc:Process a owl:Class ;
    rdfs:label "Process" ;
    skos:narrowMatch iof-constr:ManufacturingProcess ;    
    skos:narrowMatch iof-constr:AssemblyProcess ;    
    skos:narrowMatch iof-constr:ComputingProcess .

sc:Resource a owl:Class ;
    rdfs:label "Resource" ;
    skos:narrowMatch iof-constr:MaterialResource .

sc:MaterialResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:MaterialResource ;
    rdfs:label "Material Resource" ;
    rdfs:comment "Physical/material resource used in a manufacturing service chain." .

sc:HumanResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:Person ;
    skos:broadMatch iof-constr:Agent ;
    rdfs:label "Human Resource" ;
    rdfs:comment "Human workforce resource used in a manufacturing service chain." .

sc:SoftwareResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:InformationContentEntity ;
    skos:relatedMatch iof-constr:Algorithm ;
    skos:relatedMatch iof-constr:EncodedAlgorithm ;
    rdfs:label "Software Resource" ;
    rdfs:comment "Software, algorithmic, or informational resource used in a manufacturing service chain." .

sc:EquipmentResource a owl:Class ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:PieceOfEquipment ;
    rdfs:label "Equipment Resource" ;
    rdfs:comment "Equipment or machinery resource used in a manufacturing service chain." .

sc:ResourceConf a owl:Class ;
    rdfs:label "Resource Configuration" ;  
    rdfs:comment "MSC Resource Configuration is inserted between ProcessConfigurations and Resource nodes to allow multiple uses of the same resource in different configurations." .

sc:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "Supplier of resources" .

sc:Site a owl:Class ;
    rdfs:label "Manufacturing Site" ;
    rdfs:subClassOf bfo:BFO_0000029 ;    
    skos:closeMatch bfo:BFO_0000029 ;    
    rdfs:comment "Physical location where processes are performed." .

sc:Device a owl:Class ;
    rdfs:label "Device" ;
    skos:closeMatch iof-constr:PieceOfEquipment ;    
    rdfs:comment "Equipment or machinery at a site." .

sc:Characteristic a owl:Class ;
    rdfs:label "Characteristic" ;
    skos:relatedMatch iof-constr:Capability ;    
    skos:relatedMatch iof-constr:ProcessCharacteristic ;    
    skos:relatedMatch bfo:BFO_0000019 ;    
    skos:relatedMatch bfo:BFO_0000020 ;    
    rdfs:comment "MSC Characteristic is a lightweight abstraction for attributes of products, resources, devices, sites, or suppliers." .

sc:CharacteristicType a owl:Class ;
    rdfs:label "Characteristic Type" ;
    skos:relatedMatch <http://qudt.org/schema/qudt/QuantityKind> ;
    rdfs:comment "The kind of a characteristic carrying its name, measurement unit, and documentation once. Individual sc:Characteristic instances refer to a type and bind a value to a specific configurable entity." .

sc:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    skos:closeMatch iof-constr:PieceOfEquipment ;    
    skos:relatedMatch iof-constr:MeasurementCapability ;    
    skos:relatedMatch iof-constr:MeasurementProcess ;    
    rdfs:comment "Measurement device. A sensor is treated as equipment capable of participating in measurement processes." .

sc:LogisticRoute a owl:Class ;
    rdfs:label "Logistic Route" ;
    skos:relatedMatch iof-constr:MaterialLocationChangeProcess ;    
    rdfs:comment "Transportation route between locations." .
    
sc:Location a owl:Class ;
    rdfs:label "Location" ;
    skos:closeMatch bfo:BFO_0000029 ;    
    skos:relatedMatch iof-constr:PhysicalLocationIdentifier .

sc:Device rdfs:subClassOf sc:ConfigurableEntity .
sc:Site rdfs:subClassOf sc:ConfigurableEntity .
sc:Supplier rdfs:subClassOf sc:ConfigurableEntity .
sc:Resource rdfs:subClassOf sc:ConfigurableEntity .
sc:Process rdfs:subClassOf sc:ConfigurableEntity .
sc:Product rdfs:subClassOf sc:ConfigurableEntity .
sc:ProcessConfiguration rdfs:subClassOf sc:ConfigurableEntity .
sc:ResourceConf rdfs:subClassOf sc:ConfigurableEntity .
sc:LogisticRoute rdfs:subClassOf sc:ConfigurableEntity .

# ===== OBJECT PROPERTIES =====

sc:satisfiesRequirement a owl:ObjectProperty ;
    rdfs:label "satisfies requirement" ;
    rdfs:domain sc:Product ;
    rdfs:range sc:CustomerRequirement .

sc:hasComponent a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has component" ;
    rdfs:domain sc:Product ;
    rdfs:range sc:Product .

sc:requiresProcess a owl:ObjectProperty ;
    rdfs:label "requires process" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Process .

sc:usesResource a owl:ObjectProperty ;
    rdfs:label "uses resource" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Resource .

sc:usesResourceConf a owl:ObjectProperty ;
    rdfs:label "uses resource configuration" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:ResourceConf .

sc:refersToResource a owl:ObjectProperty ;
    rdfs:label "refers to resource" ;
    rdfs:domain sc:ResourceConf ;
    rdfs:range sc:Resource .

sc:subClassOf a owl:ObjectProperty ;
    rdfs:label "sub class of" ;
    rdfs:domain sc:Resource ;
    rdfs:range sc:Resource ;
    owl:inverseOf sc:superClassOf .

sc:superClassOf a owl:ObjectProperty ;
    rdfs:label "super class of" ;
    rdfs:domain sc:Resource ;
    rdfs:range sc:Resource ;
    owl:inverseOf sc:subClassOf .

sc:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Product .

sc:hasInput a owl:ObjectProperty ;
    rdfs:label "has input" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:Product .

sc:hasPreviousStep a owl:ObjectProperty ;
    rdfs:label "has previous step" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:ProcessConfiguration ;
    owl:inverseOf sc:hasNextStep .

sc:hasNextStep a owl:ObjectProperty ;
    rdfs:label "has next step" ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range sc:ProcessConfiguration ;
    owl:inverseOf sc:hasPreviousStep .

sc:isProvidedBy a owl:ObjectProperty ;
    rdfs:label "is provided by" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (sc:Resource sc:Product)
    ] ;
    rdfs:range sc:Supplier ;
    owl:inverseOf sc:provides .

sc:provides a owl:ObjectProperty ;
    rdfs:label "provides" ;
    rdfs:domain sc:Supplier ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (sc:Resource sc:Product)
    ] ;
    owl:inverseOf sc:isProvidedBy .

sc:isPerformedAt a owl:ObjectProperty ;
    rdfs:label "is performed at" ;
    rdfs:domain sc:Process ;
    rdfs:range sc:Site ;
    owl:inverseOf sc:performs .

sc:performs a owl:ObjectProperty ;
    rdfs:label "performs" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Process ;
    owl:inverseOf sc:isPerformedAt .

sc:siteHasResource a owl:ObjectProperty ;
    rdfs:label "site has resource" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Resource .

sc:suppliesTo a owl:ObjectProperty ;
    rdfs:label "supplies to" ;
    rdfs:comment "Direct supply/delivery flow from one site to another (for Adient) ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Site .

sc:hasDevice a owl:ObjectProperty ;
    rdfs:label "has device" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Device .

sc:hasCharacteristic a owl:ObjectProperty ;
    rdfs:label "has characteristic" ;
    rdfs:domain sc:ConfigurableEntity ;
    rdfs:range sc:Characteristic .

sc:hasCharacteristicType a owl:ObjectProperty ;
    rdfs:label "has characteristic type" ;
    rdfs:domain sc:Characteristic ;
    rdfs:range sc:CharacteristicType ;
    rdfs:comment "Links a characteristic instance to the type that defines its name and unit." .

sc:observes a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:domain sc:Sensor ;
    rdfs:range sc:Characteristic ;
    owl:inverseOf sc:isObservedBy .

sc:isObservedBy a owl:ObjectProperty ;
    rdfs:label "is observed by" ;
    rdfs:domain sc:Characteristic ;
    rdfs:range sc:Sensor ;
    owl:inverseOf sc:observes .

sc:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (sc:Site sc:Supplier)
    ] ;
    rdfs:range sc:Location .

sc:hasStartingPoint a owl:ObjectProperty ;
    rdfs:label "has starting point" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (sc:Site sc:Supplier sc:Location)
    ] ;
    rdfs:comment "The origin location of the route" .
 
sc:hasEndingPoint a owl:ObjectProperty ;
    rdfs:label "has ending point" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (sc:Site sc:Supplier sc:Location)
    ] ;
    rdfs:comment "The destination location of the route" .

# ===== DATA PROPERTIES of ANV =====

sc:certificationCompliance a owl:DatatypeProperty ;
    rdfs:label "certification compliance" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:decimal .

sc:costPerKg a owl:DatatypeProperty ;
    rdfs:label "cost per kg" ;
    rdfs:comment "Unit: EUR/kg." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:decimal .

sc:dimensions a owl:DatatypeProperty ;
    rdfs:label "dimensions (LxWxH)" ;
    rdfs:comment "Unit: m." ;
    rdfs:domain sc:Product ;
    rdfs:range xsd:string .

sc:earlyAgeCompressiveStrengthAt24h a owl:DatatypeProperty ;
    rdfs:label "early age compressive strength at 24h" ;
    rdfs:comment "Unit: MPa." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:decimal .

sc:energyCost a owl:DatatypeProperty ;
    rdfs:label "energy cost" ;
    rdfs:comment "Unit: EUR." ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range xsd:decimal .

sc:duration a owl:DatatypeProperty ;
    rdfs:label "duration" ;
    rdfs:comment "Unit: min." ;
    rdfs:domain sc:Process ;
    rdfs:range xsd:decimal .

sc:environmentalSustainabilityPerformance a owl:DatatypeProperty ;
    rdfs:label "environmental sustainability performance" ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:decimal .

sc:minimumTransportQuantity a owl:DatatypeProperty ;
    rdfs:label "minimum transport quantity" ;
    rdfs:comment "Unit: kg." ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:decimal .

sc:onTimeDeliveryReliability a owl:DatatypeProperty ;
    rdfs:label "on-time delivery reliability" ;
    rdfs:comment "Unit: %." ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:decimal .

sc:quality a owl:DatatypeProperty ;
    rdfs:label "quality" ;
    rdfs:comment "Unit: %." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:decimal .

sc:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity" ;
    rdfs:comment "Unit: kg." ;
    rdfs:domain sc:ResourceConf ;
    rdfs:range xsd:decimal .

sc:reinforcementQuantity a owl:DatatypeProperty ;
    rdfs:label "reinforcement quantity" ;
    rdfs:comment "Unit: kg." ;
    rdfs:domain sc:ResourceConf ;
    rdfs:range xsd:decimal .

sc:resourceCost a owl:DatatypeProperty ;
    rdfs:label "resource cost" ;
    rdfs:comment "Unit: EUR." ;
    rdfs:domain sc:ResourceConf ;
    rdfs:range xsd:decimal .

sc:resourceCostANVValidated a owl:DatatypeProperty ;
    rdfs:label "resource cost (ANV validated)" ;
    rdfs:comment "Unit: EUR." ;
    rdfs:domain sc:ResourceConf ;
    rdfs:range xsd:decimal .

sc:supplyLeadTime a owl:DatatypeProperty ;
    rdfs:label "supply lead time" ;
    rdfs:comment "Unit: days." ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:decimal .

sc:totalCost a owl:DatatypeProperty ;
    rdfs:label "total cost" ;
    rdfs:comment "Unit: EUR." ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range xsd:decimal .

sc:totalPrintingTime a owl:DatatypeProperty ;
    rdfs:label "total printing time" ;
    rdfs:comment "Unit: min." ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range xsd:decimal .

sc:transportCost a owl:DatatypeProperty ;
    rdfs:label "transport cost" ;
    rdfs:comment "Unit: EUR." ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range xsd:decimal .

sc:transportCostANVValidated a owl:DatatypeProperty ;
    rdfs:label "transport cost (ANV validated)" ;
    rdfs:comment "Unit: EUR." ;
    rdfs:domain sc:ProcessConfiguration ;
    rdfs:range xsd:decimal .

sc:transportDistance a owl:DatatypeProperty ;
    rdfs:label "transport distance" ;
    rdfs:comment "Unit: km." ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:decimal .

sc:wallThickness a owl:DatatypeProperty ;
    rdfs:label "wall thickness" ;
    rdfs:comment "Unit: mm." ;
    rdfs:domain sc:Product ;
    rdfs:range xsd:decimal .

# ===== DATA PROPERTIES of CATONE =====

sc:totalWorkers a owl:DatatypeProperty ;
    rdfs:label "total workers" ;
    rdfs:comment "Unit: workers." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

sc:morningShiftWorkers a owl:DatatypeProperty ;
    rdfs:label "morning shift workers" ;
    rdfs:comment "Unit: workers." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

sc:afternoonShiftWorkers a owl:DatatypeProperty ;
    rdfs:label "afternoon shift workers" ;
    rdfs:comment "Unit: workers." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

sc:totalDrivers a owl:DatatypeProperty ;
    rdfs:label "total drivers" ;
    rdfs:comment "Unit: drivers." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

sc:totalParkingSlots a owl:DatatypeProperty ;
    rdfs:label "total parking slots" ;
    rdfs:comment "Unit: parking slots." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

sc:m2 a owl:DatatypeProperty ;
    rdfs:label "floor area" ;
    rdfs:comment "Unit: m2." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:decimal .

sc:maximumCapacityInPallets a owl:DatatypeProperty ;
    rdfs:label "maximum capacity in pallets" ;
    rdfs:comment "Unit: pallets." ;
    rdfs:domain sc:Supplier ;
    rdfs:range xsd:integer .

sc:pallets80x120 a owl:DatatypeProperty ;
    rdfs:label "capacity in 80x120 pallets" ;
    rdfs:comment "Unit: pallets (80x120 cm)." ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

## ===== DATA PROPERTIES of AEGEAN =====

sc:characteristicValue a owl:DatatypeProperty ;
    rdfs:label "characteristic value" ;
    rdfs:domain sc:Characteristic ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The numeric value of a characteristic instance, expressed in the unit declared by its characteristic type." .

sc:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:domain sc:CharacteristicType ;
    rdfs:range xsd:string ;
    rdfs:comment "Human-readable measurement unit shared by all instances of this characteristic type." .

# ===== DATA PROPERTIES of ADIENT =====

sc:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

sc:tier a owl:DatatypeProperty ;
    rdfs:label "tier" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:integer .

sc:nodeId a owl:DatatypeProperty ;
    rdfs:label "node identifier" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:integer .

sc:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

sc:entity a owl:DatatypeProperty ;
    rdfs:label "entity type" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:string .

sc:siteType a owl:DatatypeProperty ;
    rdfs:label "site type" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:string .

sc:productionRate a owl:DatatypeProperty ;
    rdfs:label "production rate" ;
    rdfs:domain sc:Site ;
    rdfs:range xsd:string .

sc:routeId a owl:DatatypeProperty ;
    rdfs:label "route identifier" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:string .

sc:freightMode a owl:DatatypeProperty ;
    rdfs:label "freight mode" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:string .

sc:leadTimeDays a owl:DatatypeProperty ;
    rdfs:label "lead time in days" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:decimal .

sc:emptyTruckCap a owl:DatatypeProperty ;
    rdfs:label "empty truck capacity" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:integer .

sc:fullTruckCap a owl:DatatypeProperty ;
    rdfs:label "full truck capacity" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:integer .

sc:qDaysBetweenReceivingsForFTLs a owl:DatatypeProperty ;
    rdfs:label "average days between receivings for FTLs" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:decimal .

sc:qDaysBetweenEmptyReturnsFTLs a owl:DatatypeProperty ;
    rdfs:label "average days between empty returns for FTLs" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:decimal .

sc:approxTransportCostFullTruck a owl:DatatypeProperty ;
    rdfs:label "approximate transport cost for full trucks" ;
    rdfs:domain sc:LogisticRoute ;
    rdfs:range xsd:integer .

sc:status a owl:DatatypeProperty ;
    rdfs:label "current lifecycle stage of the product" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:string .

sc:numberOfUses a owl:DatatypeProperty ;
    rdfs:label "number of usage cycles" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:integer .

sc:condition a owl:DatatypeProperty ;
    rdfs:label "physical condition of the product" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:string .

sc:currentLocation a owl:DatatypeProperty ;
    rdfs:label "current facility or warehouse location" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:string .

sc:lastMaintenanceDate a owl:DatatypeProperty ;
    rdfs:label "date of last maintenance" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:date .

sc:lifecycleCarbonFootprint a owl:DatatypeProperty ;
    rdfs:label "date of last maintenance" ;
    rdfs:domain sc:Resource ;
    rdfs:range xsd:decimal .
