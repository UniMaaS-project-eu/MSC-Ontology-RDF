    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    dcterms:publisher <http://unimaas-project.eu/participant/mro_l> ;
    dcterms:title "Low-Cost MRO – maintenance site capabilities"@en ;
