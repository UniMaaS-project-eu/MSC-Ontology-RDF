@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scanv:location_stuttgart a sc:Location ;
    rdfs:label "Stuttgart" .

scanv:supplier_sika a sc:Supplier ;
    rdfs:label "Sika" ;
    sc:hasLocation scanv:location_stuttgart ;
    sc:minimumTransportQuantity 10000 ;
    sc:provides scanv:resource_uhpc_concrete_sika,
        scanv:resource_uhpc_concrete_sika_2 ;
    sc:supplyLeadTime 14 .

scanv:resource_uhpc_concrete_sika a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "UHPC Concrete (Sika)" ;
    sc:certificationCompliance 9 ;
    sc:costPerKg 1.25 ;
    sc:earlyAgeCompressiveStrengthAt24h 10 ;
    sc:isProvidedBy scanv:supplier_sika ;
    sc:subClassOf scanv:resource_uhpc_concrete ;
    skos:broader scanv:resource_uhpc_concrete .

scanv:resource_uhpc_concrete_sika_2 a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "UHPC Concrete (Sika #2)" ;
    sc:certificationCompliance 9 ;
    sc:costPerKg 1.21 ;
    sc:earlyAgeCompressiveStrengthAt24h 10 ;
    sc:isProvidedBy scanv:supplier_sika ;
    sc:subClassOf scanv:resource_uhpc_concrete ;
    skos:broader scanv:resource_uhpc_concrete .

scanv:resource_uhpc_concrete sc:superClassOf scanv:resource_uhpc_concrete_sika,
        scanv:resource_uhpc_concrete_sika_2 ;
    skos:narrower scanv:resource_uhpc_concrete_sika,
        scanv:resource_uhpc_concrete_sika_2 .

