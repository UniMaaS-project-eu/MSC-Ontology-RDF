@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scanv:location_odz a sc:Location ;
    rdfs:label "Łódz" .

scanv:supplier_atlas a sc:Supplier ;
    rdfs:label "Atlas" ;
    sc:hasLocation scanv:location_odz ;
    sc:minimumTransportQuantity 10000 ;
    sc:provides scanv:resource_standard_concrete_atlas ;
    sc:supplyLeadTime 14 .

scanv:resource_standard_concrete sc:superClassOf scanv:resource_standard_concrete_atlas ;
    skos:narrower scanv:resource_standard_concrete_atlas .

scanv:resource_standard_concrete_atlas a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "Standard Concrete (Atlas)" ;
    sc:certificationCompliance 2 ;
    sc:costPerKg 0.52 ;
    sc:isProvidedBy scanv:supplier_atlas ;
    sc:subClassOf scanv:resource_standard_concrete ;
    skos:broader scanv:resource_standard_concrete .

