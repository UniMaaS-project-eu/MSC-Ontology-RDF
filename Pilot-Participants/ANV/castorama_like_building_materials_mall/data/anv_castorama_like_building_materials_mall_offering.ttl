@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scanv:location_warsaw a sc:Location ;
    rdfs:label "Warsaw" .

scanv:supplier_castorama_like_building_materials_mall a sc:Supplier ;
    rdfs:label "castorama like building materials mall" ;
    sc:hasLocation scanv:location_warsaw ;
    sc:minimumTransportQuantity 1000 ;
    sc:provides scanv:resource_standard_concrete_castorama_like_building_materials_mall,
        scanv:resource_standard_concrete_castorama_like_building_materials_mall_2 ;
    sc:supplyLeadTime 5 .

scanv:resource_standard_concrete_castorama_like_building_materials_mall a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "Standard Concrete (castorama like building materials mall)" ;
    sc:certificationCompliance 2 ;
    sc:costPerKg 0.15 ;
    sc:isProvidedBy scanv:supplier_castorama_like_building_materials_mall ;
    sc:subClassOf scanv:resource_standard_concrete ;
    skos:broader scanv:resource_standard_concrete .

scanv:resource_standard_concrete_castorama_like_building_materials_mall_2 a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "Standard Concrete (castorama like building materials mall #2)" ;
    sc:certificationCompliance 3 ;
    sc:costPerKg 0.28 ;
    sc:isProvidedBy scanv:supplier_castorama_like_building_materials_mall ;
    sc:subClassOf scanv:resource_standard_concrete ;
    skos:broader scanv:resource_standard_concrete .

scanv:resource_standard_concrete sc:superClassOf scanv:resource_standard_concrete_castorama_like_building_materials_mall,
        scanv:resource_standard_concrete_castorama_like_building_materials_mall_2 ;
    skos:narrower scanv:resource_standard_concrete_castorama_like_building_materials_mall,
        scanv:resource_standard_concrete_castorama_like_building_materials_mall_2 .

