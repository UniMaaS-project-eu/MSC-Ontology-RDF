<http://unimaas-project.eu/dataset/anv/anv_supplier_assessment> a void:Dataset,
        dcat:Dataset ;
    dcterms:conformsTo <http://unimaas-project.eu/MSCMetadata/0.2.0>,
        <http://unimaas-project.eu/MSCOntology/1.2.0> ;
    dcterms:creator <http://unimaas-project.eu/participant/anv> ;
    dcterms:description "ANV's buyer-side evaluation of material suppliers (on-time delivery reliability, environmental sustainability score, remarks) and of their material offerings (quality score)."@en ;
    dcterms:identifier "anv_supplier_assessment" ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    dcterms:publisher <http://unimaas-project.eu/participant/anv> ;
    dcterms:requires <http://unimaas-project.eu/dataset/anv/anv_atlas_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_castorama_like_building_materials_mall_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_cemex_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_crh_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_holcim_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_mapei_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_sika_offering> ;
    dcterms:title "ANV supplier and material assessment"@en ;
    void:entities 0 ;
    void:propertyPartition [ void:property rdfs:comment ;
            void:triples 1 ],
        [ void:property sc:quality ;
            void:triples 9 ],
        [ void:property sc:onTimeDeliveryReliability ;
            void:triples 7 ],
        [ void:property sc:environmentalSustainabilityPerformance ;
            void:triples 7 ] ;
    void:triples 24 ;
    void:vocabulary sc: ;
    mscmeta:dataOrigin "ANV pilot spreadsheets (supplier list, material data, product/process cost sheets) transformed to RDF with the MSC ontology; partitioned per data owner for the DMS simulation." ;
    mscmeta:ingestionTarget "CentralKG" ;
    mscmeta:materialCategory scanv:resource_standard_concrete,
        scanv:resource_uhpc_concrete ;
    mscmeta:mscFacet "SupplierAssessment" ;
    mscmeta:mscOntologyVersion "1.2.0" ;
    mscmeta:pilot "anv" ;
    mscmeta:sharedEntity scanv:resource_standard_concrete_atlas,
        scanv:resource_standard_concrete_castorama_like_building_materials_mall,
        scanv:resource_standard_concrete_castorama_like_building_materials_mall_2,
        scanv:resource_standard_concrete_cemex,
        scanv:resource_standard_concrete_crh,
        scanv:resource_uhpc_concrete_holcim,
        scanv:resource_uhpc_concrete_mapei,
        scanv:resource_uhpc_concrete_sika,
        scanv:resource_uhpc_concrete_sika_2,
        scanv:supplier_atlas,
        scanv:supplier_castorama_like_building_materials_mall,
        scanv:supplier_cemex,
        scanv:supplier_crh,
        scanv:supplier_holcim,
        scanv:supplier_mapei,
        scanv:supplier_sika ;
    mscmeta:syntheticDataset false ;
    dcat:distribution <http://unimaas-project.eu/dataset/anv/anv_supplier_assessment/distribution/ttl> ;
    dcat:keyword "3D concrete printing"@en,
        "SupplierAssessment"@en,
        "construction"@en,
        "manufacturing service chain"@en,
        "street furniture"@en ;
    dcat:version "1.0.0" .

<http://unimaas-project.eu/dataset/anv/anv_supplier_assessment/distribution/ttl> a dcat:Distribution ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dcat:byteSize 1610 ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle> .

<http://unimaas-project.eu/participant/anv> a foaf:Organization ;
    dcterms:identifier "did:web:edc-proxy-anv%3A80:anv" ;
