@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mscmeta: <http://unimaas-project.eu/MSCMetadata#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://unimaas-project.eu/dataset/anv/anv_logistics> a void:Dataset,
        dcat:Dataset ;
    dcterms:conformsTo <http://unimaas-project.eu/MSCMetadata/0.2.0>,
        <http://unimaas-project.eu/MSCOntology/1.2.0> ;
    dcterms:creator <http://unimaas-project.eu/participant/anv> ;
    dcterms:description "Logistic routes from the ANV site to each material supplier with transport distances."@en ;
    dcterms:identifier "anv_logistics" ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    dcterms:publisher <http://unimaas-project.eu/participant/anv> ;
    dcterms:requires <http://unimaas-project.eu/dataset/anv/anv_atlas_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_castorama_like_building_materials_mall_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_cemex_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_crh_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_holcim_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_mapei_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_sika_offering>,
        <http://unimaas-project.eu/dataset/anv/anv_site_capabilities> ;
    dcterms:title "ANV inbound logistic routes"@en ;
    void:classPartition [ void:class sc:LogisticRoute ;
            void:entities 7 ] ;
    void:entities 7 ;
    void:propertyPartition [ void:property rdfs:label ;
            void:triples 7 ],
        [ void:property sc:hasEndingPoint ;
            void:triples 7 ],
        [ void:property rdf:type ;
            void:triples 7 ],
        [ void:property sc:transportDistance ;
            void:triples 4 ],
        [ void:property sc:hasStartingPoint ;
            void:triples 7 ] ;
    void:triples 32 ;
    void:vocabulary sc: ;
    mscmeta:aboutLogisticRoute scanv:route_anv_to_atlas,
        scanv:route_anv_to_castorama_like_building_materials_mall,
        scanv:route_anv_to_cemex,
        scanv:route_anv_to_crh,
        scanv:route_anv_to_holcim,
        scanv:route_anv_to_mapei,
        scanv:route_anv_to_sika ;
    mscmeta:dataOrigin "ANV pilot spreadsheets (supplier list, material data, product/process cost sheets) transformed to RDF with the MSC ontology; partitioned per data owner for the DMS simulation." ;
    mscmeta:ingestionTarget "CentralKG" ;
    mscmeta:mscFacet "LogisticRoute" ;
    mscmeta:mscOntologyVersion "1.2.0" ;
    mscmeta:pilot "anv" ;
    mscmeta:sharedEntity scanv:site_anv,
        scanv:supplier_atlas,
        scanv:supplier_castorama_like_building_materials_mall,
        scanv:supplier_cemex,
        scanv:supplier_crh,
        scanv:supplier_holcim,
        scanv:supplier_mapei,
        scanv:supplier_sika ;
    mscmeta:syntheticDataset false ;
    dcat:distribution <http://unimaas-project.eu/dataset/anv/anv_logistics/distribution/ttl> ;
    dcat:keyword "3D concrete printing"@en,
        "LogisticRoute"@en,
        "construction"@en,
        "manufacturing service chain"@en,
        "street furniture"@en ;
    dcat:version "1.0.0" .

<http://unimaas-project.eu/dataset/anv/anv_logistics/distribution/ttl> a dcat:Distribution ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dcat:byteSize 1601 ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle> .

<http://unimaas-project.eu/participant/anv> a foaf:Organization ;
    dcterms:identifier "did:web:edc-proxy-anv%3A80:anv" ;
    foaf:name "ANV" .

