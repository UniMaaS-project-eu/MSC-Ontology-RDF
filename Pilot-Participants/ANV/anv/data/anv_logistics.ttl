@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scanv:route_anv_to_atlas a sc:LogisticRoute ;
    rdfs:label "ANV to Atlas" ;
    sc:hasEndingPoint scanv:supplier_atlas ;
    sc:hasStartingPoint scanv:site_anv ;
    sc:transportDistance 100 .

scanv:route_anv_to_castorama_like_building_materials_mall a sc:LogisticRoute ;
    rdfs:label "ANV to castorama like building materials mall" ;
    sc:hasEndingPoint scanv:supplier_castorama_like_building_materials_mall ;
    sc:hasStartingPoint scanv:site_anv ;
    sc:transportDistance 10 .

scanv:route_anv_to_cemex a sc:LogisticRoute ;
    rdfs:label "ANV to cemex" ;
    sc:hasEndingPoint scanv:supplier_cemex ;
    sc:hasStartingPoint scanv:site_anv .

scanv:route_anv_to_crh a sc:LogisticRoute ;
    rdfs:label "ANV to crh" ;
    sc:hasEndingPoint scanv:supplier_crh ;
    sc:hasStartingPoint scanv:site_anv .

scanv:route_anv_to_holcim a sc:LogisticRoute ;
    rdfs:label "ANV to Holcim" ;
    sc:hasEndingPoint scanv:supplier_holcim ;
    sc:hasStartingPoint scanv:site_anv ;
    sc:transportDistance 10 .

scanv:route_anv_to_mapei a sc:LogisticRoute ;
    rdfs:label "ANV to mapei" ;
    sc:hasEndingPoint scanv:supplier_mapei ;
    sc:hasStartingPoint scanv:site_anv .

scanv:route_anv_to_sika a sc:LogisticRoute ;
    rdfs:label "ANV to Sika" ;
    sc:hasEndingPoint scanv:supplier_sika ;
    sc:hasStartingPoint scanv:site_anv ;
    sc:transportDistance 1100 .

