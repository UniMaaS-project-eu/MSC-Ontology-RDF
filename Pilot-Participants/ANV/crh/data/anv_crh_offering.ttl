@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scanv:location_atlanta a sc:Location ;
    rdfs:label "Atlanta" .

scanv:supplier_crh a sc:Supplier ;
    rdfs:label "crh" ;
    sc:hasLocation scanv:location_atlanta ;
    sc:minimumTransportQuantity 10000 ;
    sc:provides scanv:resource_standard_concrete_crh ;
    sc:supplyLeadTime 30 .

scanv:resource_standard_concrete sc:superClassOf scanv:resource_standard_concrete_crh ;
    skos:narrower scanv:resource_standard_concrete_crh .

scanv:resource_standard_concrete_crh a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "Standard Concrete (crh)" ;
    sc:certificationCompliance 7 ;
    sc:costPerKg 1.5 ;
    sc:isProvidedBy scanv:supplier_crh ;
    sc:subClassOf scanv:resource_standard_concrete ;
    skos:broader scanv:resource_standard_concrete .

