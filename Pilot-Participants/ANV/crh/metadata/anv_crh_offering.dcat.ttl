<http://unimaas-project.eu/dataset/anv/anv_crh_offering> a void:Dataset,
        dcat:Dataset ;
    dcterms:conformsTo <http://unimaas-project.eu/MSCMetadata/0.2.0>,
        <http://unimaas-project.eu/MSCOntology/1.2.0> ;
    dcterms:creator <http://unimaas-project.eu/participant/crh> ;
    dcterms:description "Supplier self-declaration of crh: location, lead time, minimum transport quantity and technical/commercial data of the offered materials (Standard Concrete (crh)), linked to ANV's generic material categories."@en ;
    dcterms:identifier "anv_crh_offering" ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    dcterms:publisher <http://unimaas-project.eu/participant/crh> ;
    dcterms:requires <http://unimaas-project.eu/dataset/anv/anv_site_capabilities> ;
    dcterms:spatial scanv:location_atlanta ;
    dcterms:title "crh material offering for ANV 3D printing"@en ;
    void:classPartition [ void:class sc:Location ;
            void:entities 1 ],
        [ void:class sc:MaterialResource ;
            void:entities 1 ],
        [ void:class sc:Resource ;
            void:entities 1 ],
        [ void:class sc:Supplier ;
            void:entities 1 ] ;
    void:entities 3 ;
    void:propertyPartition [ void:property skos:broader ;
            void:triples 1 ],
        [ void:property sc:provides ;
            void:triples 1 ],
        [ void:property sc:minimumTransportQuantity ;
            void:triples 1 ],
        [ void:property sc:subClassOf ;
            void:triples 1 ],
        [ void:property sc:supplyLeadTime ;
            void:triples 1 ],
        [ void:property sc:isProvidedBy ;
            void:triples 1 ],
        [ void:property skos:narrower ;
            void:triples 1 ],
        [ void:property sc:hasLocation ;
            void:triples 1 ],
        [ void:property sc:superClassOf ;
            void:triples 1 ],
        [ void:property sc:costPerKg ;
            void:triples 1 ],
        [ void:property sc:certificationCompliance ;
            void:triples 1 ],
        [ void:property rdfs:label ;
            void:triples 3 ],
        [ void:property rdf:type ;
            void:triples 4 ] ;
    void:triples 18 ;
    void:vocabulary sc: ;
    mscmeta:aboutLocation scanv:location_atlanta ;
    mscmeta:aboutResource scanv:resource_standard_concrete_crh ;
    mscmeta:aboutSupplier scanv:supplier_crh ;
    mscmeta:dataOrigin "ANV pilot spreadsheets (supplier list, material data, product/process cost sheets) transformed to RDF with the MSC ontology; partitioned per data owner for the DMS simulation." ;
    mscmeta:ingestionTarget "CentralKG" ;
    mscmeta:materialCategory scanv:resource_standard_concrete ;
    mscmeta:mscFacet "Supplier" ;
    mscmeta:mscOntologyVersion "1.2.0" ;
    mscmeta:pilot "anv" ;
    mscmeta:sharedEntity scanv:resource_standard_concrete ;
    mscmeta:syntheticDataset false ;
    dcat:distribution <http://unimaas-project.eu/dataset/anv/anv_crh_offering/distribution/ttl> ;
    dcat:keyword "3D concrete printing"@en,
        "Supplier"@en,
        "construction"@en,
        "manufacturing service chain"@en,
        "street furniture"@en ;
    dcat:version "1.0.0" .

