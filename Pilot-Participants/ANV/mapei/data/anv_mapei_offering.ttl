@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scanv: <http://unimaas-project.eu/MSCOntology/data/anv/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scanv:location_mediolan a sc:Location ;
    rdfs:label "Mediolan" .

scanv:supplier_mapei a sc:Supplier ;
    rdfs:label "mapei" ;
    sc:hasLocation scanv:location_mediolan ;
    sc:minimumTransportQuantity 10000 ;
    sc:provides scanv:resource_uhpc_concrete_mapei ;
    sc:supplyLeadTime 14 .

scanv:resource_uhpc_concrete sc:superClassOf scanv:resource_uhpc_concrete_mapei ;
    skos:narrower scanv:resource_uhpc_concrete_mapei .

scanv:resource_uhpc_concrete_mapei a sc:MaterialResource,
        sc:Resource ;
    rdfs:label "UHPC Concrete (mapei)" ;
    sc:certificationCompliance 6 ;
    sc:costPerKg 1.3 ;
    sc:earlyAgeCompressiveStrengthAt24h 6.9 ;
    sc:isProvidedBy scanv:supplier_mapei ;
    sc:subClassOf scanv:resource_uhpc_concrete ;
    skos:broader scanv:resource_uhpc_concrete .

