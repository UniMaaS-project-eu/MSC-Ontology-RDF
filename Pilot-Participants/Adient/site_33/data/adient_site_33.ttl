@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scadient: <http://unimaas-project.eu/MSCOntology/data/adient/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scadient:pconf_3 a sc:ProcessConfiguration ;
    sc:hasNextStep scadient:pconf_4 ;
    sc:hasOutput scadient:product_metal_structures ;
    sc:hasPreviousStep scadient:pconf_1,
        scadient:pconf_2 ;
    sc:name "PC3" ;
    sc:requiresProcess scadient:process_metal_structures_making .

scadient:route_11_33 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 2185 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "FTL" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_33 ;
    sc:hasStartingPoint scadient:site_11 ;
    sc:leadTimeDays 5.0 ;
    sc:qDaysBetweenEmptyReturnsFTLs 12.1 ;
    sc:qDaysBetweenReceivingsForFTLs 3.3 ;
    sc:routeId "11_33" ;
    sc:transportDistance 2185 .

scadient:route_335_33 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 420 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "GRP" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_33 ;
    sc:hasStartingPoint scadient:site_335 ;
    sc:leadTimeDays 1.0 ;
    sc:qDaysBetweenEmptyReturnsFTLs 19.1 ;
    sc:qDaysBetweenReceivingsForFTLs 5.2 ;
    sc:routeId "335_33" ;
    sc:transportDistance 420 .

scadient:route_35_33 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 2783 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "GRP" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_33 ;
    sc:hasStartingPoint scadient:site_35 ;
    sc:leadTimeDays 6.0 ;
    sc:qDaysBetweenEmptyReturnsFTLs 5.6 ;
    sc:qDaysBetweenReceivingsForFTLs 1.5 ;
    sc:routeId "35_33" ;
    sc:transportDistance 2783 .

scadient:route_707_33 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 1201 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "FTL" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_33 ;
    sc:hasStartingPoint scadient:site_707 ;
    sc:leadTimeDays 2.5 ;
    sc:qDaysBetweenEmptyReturnsFTLs 1391.5 ;
    sc:qDaysBetweenReceivingsForFTLs 379.5 ;
    sc:routeId "707_33" ;
    sc:transportDistance 1201 .

scadient:suppliesTo a owl:ObjectProperty ;
    rdfs:label "supplies to" ;
    rdfs:comment "Direct supply/delivery flow from one site to another (from Neo4j [:TO] relationship)" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Site .

scadient:product_metal_structures a sc:Product ;
    sc:name "metal structures" .

scadient:process_metal_structures_making a sc:Process ;
    sc:isPerformedAt scadient:site_33 ;
    sc:name "metal structures making" .

scadient:site_33 a sc:Site ;
    sc:country "HU" ;
    sc:entity "internal" ;
    sc:nodeId 33 ;
    sc:performs scadient:process_metal_structures_making ;
    sc:productionRate "weekly batches" ;
    sc:siteType "metal" ;
    sc:tier 2 ;
    scadient:suppliesTo scadient:site_14,
        scadient:site_37,
        scadient:site_50,
        scadient:site_64 .

