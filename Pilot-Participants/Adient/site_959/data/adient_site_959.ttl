@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scadient: <http://unimaas-project.eu/MSCOntology/data/adient/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scadient:pconf_1 a sc:ProcessConfiguration ;
    sc:hasNextStep scadient:pconf_3 ;
    sc:hasOutput scadient:product_metal_stampings ;
    sc:name "PC1" ;
    sc:requiresProcess scadient:process_metal_stampings_making .

scadient:suppliesTo a owl:ObjectProperty ;
    rdfs:label "supplies to" ;
    rdfs:comment "Direct supply/delivery flow from one site to another (from Neo4j [:TO] relationship)" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Site .

scadient:product_metal_stampings a sc:Product ;
    sc:name "metal stampings" .

scadient:site_959 a sc:Site ;
    sc:country "CZ" ;
    sc:entity "external" ;
    sc:nodeId 959 ;
    sc:performs scadient:process_metal_stampings_making ;
    sc:productionRate "fortnightly batches" ;
    sc:siteType "3p" ;
    scadient:suppliesTo scadient:site_11 .

scadient:process_metal_stampings_making a sc:Process ;
    sc:isPerformedAt scadient:site_959 ;
    sc:name "metal stampings making" .

