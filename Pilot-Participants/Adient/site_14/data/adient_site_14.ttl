@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scadient: <http://unimaas-project.eu/MSCOntology/data/adient/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scadient:pconf_4 a sc:ProcessConfiguration ;
    sc:hasOutput scadient:product_full_seats ;
    sc:hasPreviousStep scadient:pconf_3 ;
    sc:name "PC4" ;
    sc:requiresProcess scadient:process_full_seats_making .

scadient:route_220_14 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 2590 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "GRP" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_14 ;
    sc:hasStartingPoint scadient:site_220 ;
    sc:leadTimeDays 6.0 ;
    sc:qDaysBetweenEmptyReturnsFTLs 927.7 ;
    sc:qDaysBetweenReceivingsForFTLs 253.0 ;
    sc:routeId "220_14" ;
    sc:transportDistance 2590 .

scadient:route_33_14 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 1106 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "FTL" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_14 ;
    sc:hasStartingPoint scadient:site_33 ;
    sc:leadTimeDays 2.5 ;
    sc:qDaysBetweenEmptyReturnsFTLs 5.5 ;
    sc:qDaysBetweenReceivingsForFTLs 1.5 ;
    sc:routeId "33_14" ;
    sc:transportDistance 1106 .

scadient:product_full_seats a sc:Product ;
    sc:name "full seats" .

scadient:process_full_seats_making a sc:Process ;
    sc:isPerformedAt scadient:site_14 ;
    sc:name "full seats making" .

scadient:site_14 a sc:Site ;
    sc:country "HU" ;
    sc:entity "internal" ;
    sc:nodeId 14 ;
    sc:performs scadient:process_full_seats_making ;
    sc:productionRate "just-in-time" ;
    sc:siteType "JIT" ;
    sc:tier 1 .

