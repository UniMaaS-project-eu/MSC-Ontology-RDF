            void:entities 6 ] ;
    void:entities 6 ;
    void:propertyPartition [ void:property sc:freightMode ;
            void:triples 6 ],
        [ void:property sc:qDaysBetweenReceivingsForFTLs ;
            void:triples 6 ],
        [ void:property sc:leadTimeDays ;
            void:triples 6 ],
        [ void:property sc:hasStartingPoint ;
            void:triples 6 ],
        [ void:property sc:approxTransportCostFullTruck ;
            void:triples 6 ],
        [ void:property rdf:type ;
            void:triples 6 ],
        [ void:property sc:routeId ;
            void:triples 6 ],
        [ void:property sc:fullTruckCap ;
            void:triples 6 ],
        [ void:property sc:transportDistance ;
            void:triples 6 ],
        [ void:property sc:hasEndingPoint ;
            void:triples 6 ],
        [ void:property sc:emptyTruckCap ;
            void:triples 6 ],
        [ void:property sc:qDaysBetweenEmptyReturnsFTLs ;
            void:triples 6 ] ;
    void:triples 72 ;
