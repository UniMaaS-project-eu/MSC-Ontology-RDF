        <http://unimaas-project.eu/dataset/adient/adient_site_322_site_capabilities>,
        <http://unimaas-project.eu/dataset/adient/adient_site_34_site_capabilities>,
        <http://unimaas-project.eu/dataset/adient/adient_site_35_site_capabilities>,
        <http://unimaas-project.eu/dataset/adient/adient_site_959_site_capabilities> ;
    dcterms:spatial <http://publications.europa.eu/resource/authority/country/POL> ;
    dcterms:title "Adient site 11 – inbound logistic routes"@en ;
