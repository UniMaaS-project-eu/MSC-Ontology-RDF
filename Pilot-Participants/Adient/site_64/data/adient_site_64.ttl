@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scadient: <http://unimaas-project.eu/MSCOntology/data/adient/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scadient:pconf_4 a sc:ProcessConfiguration ;
    sc:hasOutput scadient:product_full_seats ;
    sc:hasPreviousStep scadient:pconf_3 ;
    sc:name "PC4" ;
    sc:requiresProcess scadient:process_full_seats_making .

scadient:route_220_64 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 989 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "FTL" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_64 ;
    sc:hasStartingPoint scadient:site_220 ;
    sc:leadTimeDays 2.0 ;
    sc:qDaysBetweenEmptyReturnsFTLs 8.0 ;
    sc:qDaysBetweenReceivingsForFTLs 2.2 ;
    sc:routeId "220_64" ;
    sc:transportDistance 989 .

scadient:route_33_64 a sc:LogisticRoute ;
    sc:approxTransportCostFullTruck 559 ;
    sc:emptyTruckCap 363 ;
    sc:freightMode "FTL" ;
    sc:fullTruckCap 99 ;
    sc:hasEndingPoint scadient:site_64 ;
    sc:hasStartingPoint scadient:site_33 ;
    sc:leadTimeDays 1.5 ;
    sc:qDaysBetweenEmptyReturnsFTLs 1.6 ;
    sc:qDaysBetweenReceivingsForFTLs 0.4 ;
    sc:routeId "33_64" ;
    sc:transportDistance 559 .

scadient:product_full_seats a sc:Product ;
    sc:name "full seats" .

scadient:process_full_seats_making a sc:Process ;
    sc:isPerformedAt scadient:site_64 ;
    sc:name "full seats making" .

scadient:site_64 a sc:Site ;
    sc:country "DE" ;
    sc:entity "internal" ;
    sc:nodeId 64 ;
    sc:performs scadient:process_full_seats_making ;
    sc:productionRate "just-in-time" ;
    sc:siteType "JIT" ;
    sc:tier 1 .

