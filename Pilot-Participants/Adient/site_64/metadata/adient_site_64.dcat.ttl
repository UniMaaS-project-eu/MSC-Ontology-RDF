            void:triples 2 ],
        [ void:property sc:hasStartingPoint ;
            void:triples 2 ],
        [ void:property sc:transportDistance ;
            void:triples 2 ],
        [ void:property sc:emptyTruckCap ;
            void:triples 2 ],
        [ void:property sc:freightMode ;
            void:triples 2 ] ;
    void:triples 24 ;
    void:vocabulary sc: ;
