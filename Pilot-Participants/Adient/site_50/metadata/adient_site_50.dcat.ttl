        scadient:route_730_50,
        scadient:route_972_50 ;
    mscmeta:aboutSite scadient:site_50 ;
    mscmeta:dataOrigin "Adient seat supply-network model (sites, [:TO] supply relationships and lanes exported from Neo4j) transformed to RDF with the MSC ontology; partitioned per site for the DMS simulation." ;
